# Copy to .env (never commit it) and fill in.
PI_BASE_URL=https://your-endpoint.example.com/v1
# Leave blank for local models that need no key
PI_API_KEY=
PI_MODEL=your-model-id
# Extra hosts the container may reach, comma-separated (the PI_BASE_URL host is always allowed).
# "example.com" matches only that host; ".example.com" also matches subdomains.
# "*" allows every host and port (unrestricted network).
ALLOWED_DOMAINS=
